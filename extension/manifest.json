{
  "manifest_version": 3,
  "name": "PhishGuard Student Shield",
  "version": "1.0.0",
  "description": "AI-powered phishing detection for students",
  "permissions": ["tabs", "storage", "notifications", "activeTab"],
  "host_permissions": ["[localhost](http://localhost:8000/*)", "<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "PhishGuard" },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
